{
  "publisher": "local",
  "name": "umsc-language-support",
  "displayName": "UMsc Language Support",
  "description": "Language support and validation for UMsc script files.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onLanguage:umsc"
  ],
  "main": "./dist/web/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "umsc",
        "aliases": [
          "UMsc",
          "umsc"
        ],
        "extensions": [
          ".sc"
        ]
      }
    ],
    "grammars": [
      {
        "language": "umsc",
        "scopeName": "source.umsc",
        "path": "./syntaxes/umsc.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.80.0",
    "assert": "^2.1.0",
    "esbuild": "^0.19.0",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EikitiN/umsc-language-support.git"
  }
}
